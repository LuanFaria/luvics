<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TECH LUVICS | Geoprocessamento e Renda</title>
  <style>
    :root {
      --primary: #091a26;
      --secondary: #103b31;
      --accent-orange: #ff9800;
      --accent-green: #10b981;
      --bg-light: #f8fafc;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --card-bg: #ffffff;
      --shadow: 0 20px 40px -15px rgba(15, 45, 63, 0.1);
      --radius: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-light);
      color: var(--text-main);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      scroll-behavior: smooth;
    }

    /* NAVBAR / PAINEL TECNOLÓGICO SUPERIOR */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 5%;
      background: rgba(9, 26, 38, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(16, 185, 129, 0.2);
      z-index: 1000;
    }

    .nav-logo {
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 1px;
      text-decoration: none;
    }

    .nav-logo span {
      color: var(--accent-orange);
    }

    .nav-links {
      display: flex;
      gap: 25px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.3s ease, text-shadow 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--accent-green);
      text-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
    }

    /* HEADER / HERO */
    header {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #fff;
      padding: 140px 20px 80px 20px; /* Padding superior ajustado por causa da navbar fixa */
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    
    header::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--accent-orange), var(--accent-green));
    }

    header h1 {
      font-size: 3.2rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      margin-bottom: 12px;
    }

    header p {
      font-size: 1.25rem;
      max-width: 650px;
      margin: 0 auto 24px auto;
      opacity: 0.95;
    }

    /* CTA BUTTONS */
    .cta-buttons {
      margin-top: 24px;
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .btn {
      text-decoration: none;
      padding: 14px 28px;
      background: var(--accent-orange);
      color: white;
      font-weight: 700;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 10px 25px rgba(255, 152, 0, 0.35);
      transition: all 0.2s ease;
    }

    .btn.secondary {
      background: var(--accent-green);
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);
    }

    .btn:hover {
      transform: translateY(-2px);
      filter: brightness(1.05);
      box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    }

    /* SECTIONS */
    section {
      padding: 70px 20px;
      max-width: 1100px;
      margin: auto;
    }

    .section-title {
      font-size: 2.2rem;
      color: var(--primary);
      text-align: center;
      margin-bottom: 40px;
      font-weight: 800;
    }

    /* CARD CONTAINER */
    .card-container {
      background: var(--card-bg);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 40px;
      margin-bottom: 40px;
      border: 1px solid rgba(0,0,0,0.04);
    }

    .flex {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 40px;
    }

    .flex .text, .flex .image {
      flex: 1 1 45%;
    }

    .flex img {
      width: 100%;
      border-radius: 12px;
      box-shadow: var(--shadow);
      display: block;
      transition: transform 0.3s ease;
    }

    .flex img:hover {
      transform: scale(1.02);
    }

    h2 { font-size: 1.8rem; margin-bottom: 16px; color: var(--primary); }
    p { margin-bottom: 16px; color: var(--text-muted); font-size: 1.05rem; }

    ul {
      list-style: none;
      margin-bottom: 24px;
    }

    ul li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 12px;
      color: var(--text-main);
      font-weight: 500;
    }

    ul li::before {
      content: '✔';
      position: absolute;
      left: 0;
      color: var(--accent-green);
      font-weight: bold;
    }

    blockquote {
      font-style: italic;
      background: #f1f5f9;
      padding: 20px;
      border-left: 5px solid var(--accent-green);
      margin: 20px 0;
      border-radius: 0 8px 8px 0;
      color: var(--text-main);
    }

    /* GALERIA */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 20px;
    }

    .gallery-item img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 12px;
      box-shadow: var(--shadow);
      transition: transform 0.3s ease;
    }

    .gallery-item img:hover {
      transform: translateY(-5px);
    }

    /* RODAPÉ */
    footer {
      background: var(--primary);
      color: white;
      text-align: center;
      padding: 60px 20px;
      margin-top: 40px;
    }

    footer h2 { color: white; font-size: 2rem; margin-bottom: 16px; }
    footer p { color: rgba(255,255,255,0.8); max-width: 600px; margin: 0 auto 24px auto; }
    footer a { color: #ffb46f; text-decoration: none; font-weight: 600; }
    footer a:hover { text-decoration: underline; }

    /* RESPONSIVIDADE */
    @media (max-width: 768px) {
      .navbar { padding: 15px 20px; }
      .nav-links { gap: 15px; }
      .nav-links a { font-size: 0.85rem; }
      header { padding: 120px 15px 50px 15px; }
      header h1 { font-size: 2.3rem; }
      section { padding: 40px 15px; }
      .card-container { padding: 20px; }
      .flex .text, .flex .image { flex: 1 1 100%; }
    }
  </style>
</head>
